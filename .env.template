# Copied to .env by `task init` / `task init:vault`. .env is git-ignored.
# VAULT_TOKEN is filled in from vault-init.json after `vault operator init` (root token, demo only).
export VAULT_ADDR=http://127.0.0.1:8200
export VAULT_TOKEN=
# Lab kubectl context. Taskfile.yml sets it from cluster_name; scripts run directly default to this value.
# export KUBECONTEXT=k3d-mcp-oauth-lab
# Password shared by the static Dex lab users. Lab only; the default is "password".
# export DEX_STATIC_PASSWORD=
